{
  "name": "festivals-rvp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n admin,next -c cyan,magenta \"tsx scripts/admin-server.ts\" \"next dev\"",
    "build": "npm run prepare:site && next build",
    "lint": "eslint .",
    "prepare:site": "tsx scripts/ensure-folders.ts && tsx scripts/generate-all.ts",
    "optimize": "tsx scripts/optimize-images.ts",
    "ingest": "tsx scripts/ingest-zips.ts",
    "import": "tsx scripts/import.ts",
    "import:google": "tsx scripts/import-google.ts",
    "generate": "tsx scripts/generate-all.ts",
    "publish": "tsx scripts/publish.ts",
    "admin-hash": "tsx scripts/admin-hash.ts",
    "sample-data": "tsx scripts/sample-data.ts",
    "ensure-folders": "tsx scripts/ensure-folders.ts"
  },
  "dependencies": {
    "concurrently": "^10.0.4",
    "exifr": "^7.1.3",
    "framer-motion": "^12.43.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "sharp@0.35.3": true
  }
}
