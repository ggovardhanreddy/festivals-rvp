{
  "name": "festivals-rvp",
  "version": "1.5.0",
  "private": true,
  "scripts": {
    "dev": "npm run sync && next dev",
    "build": "npm run prepare:site && next build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare:site": "tsx scripts/ensure-folders.ts && tsx scripts/sync-cms.ts && tsx scripts/sync-community-seeds.ts && tsx scripts/generate-logo-system.ts && tsx scripts/generate-ambient-music.ts && tsx scripts/generate-member-auth.ts && tsx scripts/generate-all.ts && tsx scripts/rewrite-albums-r2.ts",
    "auth:members": "tsx scripts/generate-member-auth.ts",
    "auth:members:force": "MEMBER_AUTH_FORCE=1 tsx scripts/generate-member-auth.ts",
    "sync": "tsx scripts/ensure-folders.ts && tsx scripts/sync-cms.ts",
    "sync:r2": "CMS_MERGE_R2=1 npm run sync",
    "validate": "tsx scripts/validate-site.ts",
    "test": "tsx scripts/smoke-test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.functions.json",
    "optimize": "tsx scripts/sync-cms.ts",
    "media:optimize": "tsx scripts/media-optimize.ts",
    "ingest": "tsx scripts/ingest-zips.ts",
    "import": "tsx scripts/import-folder.ts",
    "import:folder": "tsx scripts/import-folder.ts",
    "import:google": "tsx scripts/import-google.ts",
    "generate": "tsx scripts/generate-all.ts",
    "publish": "tsx scripts/publish.ts",
    "admin-hash": "tsx scripts/admin-hash.ts",
    "admin:api": "tsx scripts/admin-server.ts",
    "migrate:media": "CMS_FORCE_MEDIA=1 tsx scripts/sync-cms.ts",
    "sample-data": "tsx scripts/sample-data.ts",
    "ensure-folders": "tsx scripts/ensure-folders.ts",
    "migrate:cms": "tsx scripts/migrate-cms-layout.ts",
    "brand:assets": "tsx scripts/generate-brand-assets.ts",
    "brand:logo": "tsx scripts/generate-logo-system.ts",
    "brand:music": "tsx scripts/generate-ambient-music.ts",
    "media:migrate:r2": "tsx scripts/migrate-media-to-r2.ts",
    "media:migrate:r2:dry": "R2_MIGRATE_DRY=1 tsx scripts/migrate-media-to-r2.ts",
    "media:strip-local": "tsx scripts/strip-local-media.ts",
    "pages:fix-assets": "tsx scripts/fix-pages-asset-names.ts",
    "seo:indexnow": "tsx scripts/submit-indexnow.ts",
    "deploy:cf": "npm run build && npm run media:strip-local && npm run pages:fix-assets && wrangler pages deploy out --project-name=festivals-rvp --commit-dirty=true && npm run seo:indexnow",
    "deploy:cf:r2": "npm run media:migrate:r2 && npm run deploy:cf",
    "typecheck:app": "tsc --noEmit",
    "typecheck:functions": "tsc --noEmit -p tsconfig.functions.json",
    "rotate:members": "tsx scripts/rotate-member-passwords.ts",
    "backup:r2": "tsx scripts/backup-r2.ts",
    "backup:r2:verify": "tsx scripts/backup-r2.ts --verify",
    "migrate:verify:pre": "tsx scripts/verify-media-migration.ts --pre",
    "migrate:verify:post": "tsx scripts/verify-media-migration.ts --post",
    "fonts:sync": "tsx scripts/sync-fonts.ts",
    "content:validate": "tsx scripts/validate-content.ts",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "government:validate": "tsx scripts/validate-directory.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.4",
    "exifr": "^7.1.3",
    "framer-motion": "^12.43.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "panchang-ts": "^4.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@cloudflare/workers-types": "^5.20260730.1",
    "@fontsource/noto-sans-telugu": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "http-server": "^14.1.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5",
    "vitest": "^2.1.8",
    "wrangler": "^4.118.0",
    "zod": "^3.24.1"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "sharp@0.35.3": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260730.1": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true
  }
}
