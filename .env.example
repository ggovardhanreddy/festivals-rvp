# Generate with: npm run admin-hash -- "your-strong-password"
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Local admin API (Govardhan Reddy only)
ADMIN_API_PORT=8788

# Public site URL used by sitemap / RSS / Open Graph
# GitHub Pages: https://ggovardhanreddy.github.io/festivals-rvp
# Cloudflare Pages: https://festivals-rvp.pages.dev
NEXT_PUBLIC_SITE_URL=https://ggovardhanreddy.github.io/festivals-rvp

# Set only for GitHub project Pages builds (set automatically in Actions)
# NEXT_PUBLIC_BASE_PATH=/festivals-rvp
# Cloudflare deploy uses empty base path.
