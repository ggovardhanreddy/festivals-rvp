# Generate with: npm run admin-hash -- "your-strong-password"
ADMIN_PASSWORD_HASH=
# Super Admin username (login at /admin/)
SUPER_ADMIN_USERNAME=Govardhan
ADMIN_SESSION_SECRET=

# Fun Fest member sessions (HMAC cookie). Falls back to ADMIN_SESSION_SECRET.
MEMBER_SESSION_SECRET=

# Local admin API (Govardhan Reddy only)
ADMIN_API_PORT=8788

# Public site URL used by sitemap / RSS / Open Graph
# Custom domain (primary): https://www.reddivaripalli.com
# Cloudflare preview: https://festivals-rvp.pages.dev
NEXT_PUBLIC_SITE_URL=https://www.reddivaripalli.com

# Public contact inbox (mailto on /contact/). Optional — defaults in lib/site.ts.
# NEXT_PUBLIC_CONTACT_EMAIL=reddivaripalli.rvp@gmail.com

# Plausible analytics domain (default www.reddivaripalli.com). Set "" to disable.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=www.reddivaripalli.com

# Free Cloudflare Web Analytics beacon token (Dashboard → Analytics → Web Analytics)
# NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# Free Google Drive overflow when R2 ≥ ~90% (see docs/GOOGLE_DRIVE_OVERFLOW.md)
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REFRESH_TOKEN=
# GOOGLE_DRIVE_FOLDER_ID=
# R2_SOFT_LIMIT_BYTES=9663676416

# Google Search Console HTML tag verification (optional)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Set only for GitHub project Pages builds (set automatically in Actions)
# NEXT_PUBLIC_BASE_PATH=/festivals-rvp
# Cloudflare / custom-domain deploys use empty base path.

# ─── Cloudflare R2 media ───────────────────────────────────────────
# Bucket created in the Cloudflare dashboard / wrangler:
#   npx wrangler r2 bucket create <bucket-name>
# Enable a Public Development URL or attach a custom domain, e.g.:
#   npx wrangler r2 bucket dev-url enable <bucket-name> --force
# Bind the bucket as MEDIA in wrangler.toml + Pages → Settings → Bindings.

# Bucket name (never hardcode secrets — only the bucket name)
R2_BUCKET=

# Public base URL for objects (no trailing slash). Required at build time
# so the static site rewrites gallery URLs to R2.
# Example custom domain: https://media.reddivaripalli.com
# Example r2.dev:        https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
NEXT_PUBLIC_R2_PUBLIC_URL=

# Same public base for Pages Functions upload responses (set as a Pages secret)
R2_PUBLIC_BASE=

# HMAC secret for private signed URLs (Fun Fest / documents)
MEDIA_SIGNING_SECRET=

# Optional S3-compatible API credentials (local tooling / AWS SDK only).
# Create under Cloudflare Dashboard → R2 → Manage R2 API Tokens.
# Never commit real values.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# Migration tuning
# R2_MIGRATE_DRY=1
# R2_MIGRATE_CONCURRENCY=8
