# Dependencies
node_modules/

# Next.js / build
.next/
out/
dist/
coverage/
*.tsbuildinfo
next-env.d.ts.bak

# Env & secrets
.env
.env.*
!.env.example

# Caches & temp
.tmp/
.cache/
.turbo/
*.log
npm-debug.log*
.DS_Store
**/.DS_Store

# Import / review workspaces
inbox/*.zip
inbox/*.processed
originals/**
!originals/.gitkeep
review/**
!review/.gitkeep
!review/near-duplicates/.gitkeep
content/_oversized/

# Build-time generated catalogs (rebuilt by prepare:site).
# Keep the R2-backed album index in git so CI sparse checkouts still ship a gallery.
generated/*
!generated/albums.json
!generated/albums.r2.json

# Editor
.vscode/
.idea/

.wrangler/

# iOS / Xcode
ios/**/xcuserdata/
ios/**/DerivedData/
*.xcuserstate

# Family-tree admin editor (§17).
# The audit log is admin-only and lives in R2, reached through the
# admin-authenticated API. It is deliberately never committed and never
# imported by lib/family-trees/store.ts: a static import would copy the whole
# change history into a public _next/static chunk.
content/data/family-audit.json
# Migration backups (both the flat files and the backups/ folder the
# migration script writes).
content/data/*.bak
content/data/*.json.*.bak
content/data/backups/
