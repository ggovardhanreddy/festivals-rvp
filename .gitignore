# Dependencies
node_modules/

# Next.js / build
.next/
out/
dist/
coverage/
*.tsbuildinfo
next-env.d.ts.bak

# Env & secrets
.env
.env.*
!.env.example

# Caches & temp
.tmp/
.cache/
.turbo/
*.log
npm-debug.log*
.DS_Store
**/.DS_Store

# Import / review workspaces
inbox/*.zip
inbox/*.processed
originals/**
!originals/.gitkeep
review/**
!review/.gitkeep
!review/near-duplicates/.gitkeep
content/_oversized/

# Build-time generated catalogs (rebuilt by prepare:site).
# Keep the R2-backed album index in git so CI sparse checkouts still ship a gallery.
generated/*
!generated/albums.json
!generated/albums.r2.json

# Editor
.vscode/
.idea/

.wrangler/

# iOS / Xcode
ios/**/xcuserdata/
ios/**/DerivedData/
*.xcuserstate
