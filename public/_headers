/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: geolocation=(self), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob: https://*.r2.dev https://media.reddivaripalli.com https://*.googleusercontent.com; media-src 'self' blob: https://*.r2.dev https://media.reddivaripalli.com; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://plausible.io https://static.cloudflareinsights.com; worker-src 'self' blob:; font-src 'self' data:; connect-src 'self' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://*.r2.dev https://media.reddivaripalli.com https://plausible.io https://static.cloudflareinsights.com https://cloudflareinsights.com; frame-src 'self' https://www.google.com https://maps.google.com https://www.google.co.in; child-src 'self' blob: https://www.google.com https://maps.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' mailto:
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
/version.json
  Cache-Control: no-cache, no-store, must-revalidate
/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate
/search-index.json
  Cache-Control: no-cache, no-store, must-revalidate
/members
  Cache-Control: public, max-age=0, must-revalidate
/members/
  Cache-Control: public, max-age=0, must-revalidate
# HTML must revalidate on every request so a deploy is visible immediately.
#
# `/*.html` alone matched almost nothing: next.config has trailingSlash: true,
# so every page is requested as a directory path -- `/`, `/about/`, `/people/`
# -- and never with a .html suffix. Those requests fell through to the bare
# `/*` rule, which sets no Cache-Control, leaving the cache lifetime to the
# edge default. The two directory rules below are the ones that actually match
# real requests; the .html rule is kept for any direct-file access.
/
  Cache-Control: public, max-age=0, must-revalidate
/*/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/images/*
  Cache-Control: public, max-age=31536000, immutable
/thumbs/*
  Cache-Control: public, max-age=31536000, immutable
# Brand assets are served from Pages (see R2_PREFIXES in lib/media-url.ts) and
# have stable, unfingerprinted filenames -- village-aerial.webp keeps its name
# when the picture changes. `immutable` for a year would therefore pin the old
# homepage backdrop in every returning visitor's browser cache. An hour of
# freshness with a week of stale-while-revalidate keeps them effectively
# cache-served while still picking up a deploy the same day.
/brand/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800
/videos/*
  Cache-Control: public, max-age=31536000, immutable
/audio/*
  Cache-Control: public, max-age=31536000, immutable
/docs/*
  Cache-Control: public, max-age=31536000, immutable
